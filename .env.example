# ─────────────────────────────────────────────────────────────────────────────
# TourNet — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it contains secrets!
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Supabase (existing auth) ───────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: MongoDB Atlas → Connect → Connect your application → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tournet?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_secret_here
JWT_REFRESH_SECRET=your_different_64_char_random_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Email (existing) ──────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
