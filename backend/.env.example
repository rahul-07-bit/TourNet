# ─────────────────────────────────────────────────────────────────────────────
# TourNet Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# PORT is optional locally; Vercel ignores it (assigns its own port).
PORT=3000

# The deployed FRONTEND URL — used for CORS and OTP magic-link redirects.
# IMPORTANT: This must be the FRONTEND Vercel URL (e.g. https://tour-net-ten.vercel.app)
# NOT the backend URL. Setting this to the backend URL will break CORS.
# Multiple origins: comma-separate them, e.g. https://tour-net-ten.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# Used by: server.js (supabaseAdmin client — OTP store/verify + Auth admin API)
# Source:  Supabase Dashboard → Project Settings → API
#   SUPABASE_URL              = Project URL  (e.g. https://xxxx.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY = service_role secret key  (NOT the anon key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key_here

# ── JWT (REQUIRED for /api/auth/* password routes) ────────────────────────────
# Used by: models/User.js, middleware/auth.js, routes/auth.js
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_hex_secret_here
JWT_REFRESH_SECRET=your_different_64_char_random_hex_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Email — set at least ONE of the two options ───────────────────────────────
# Used by: server.js (sendOtpEmail — Resend tried first, SMTP is fallback)

# Option A: Resend API (recommended for production)
# Source: https://resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# Option B: SMTP / Gmail App Password (fallback if RESEND_API_KEY is absent)
# Source: Google Account → Security → 2-Step Verification → App Passwords
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ── MongoDB (OPTIONAL) ────────────────────────────────────────────────────────
# Used by: config/db.js, routes/auth.js (password-based register/login only)
# The server starts and OTP/Supabase auth works WITHOUT this variable.
# Only needed if you use /api/auth/register or /api/auth/login.
# Source: MongoDB Atlas → Connect → Connect your application → Node.js driver
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/tournet?retryWrites=true&w=majority
