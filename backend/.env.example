# ─────────────────────────────────────────────────────────────────────────────
# TourNet Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: This file contains server-side secrets. NEVER commit .env to Git.
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────────────────────

# Server Configuration
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB Atlas
# ─────────────────────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Project → Connect → Connect your application
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tournet?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Configuration (Backend — Service Role Key)
# ─────────────────────────────────────────────────────────────────────────────
# Get from: https://supabase.com → Project → Settings → API
# WARNING: Service role key has admin access — keep it secret!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key...

# Also support VITE_ names if coming from frontend .env (optional)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key...

# ─────────────────────────────────────────────────────────────────────────────
# JWT — JSON Web Token Secrets
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_secret_here
JWT_REFRESH_SECRET=your_different_64_char_random_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────────────────────────────────────────────
# Email Service (Optional — for OTP/notifications)
# ─────────────────────────────────────────────────────────────────────────────

# Resend API (Primary choice)
RESEND_API_KEY=re_your_resend_api_key_here

# OR Gmail SMTP (if using Nodemailer)
# SMTP_SERVICE=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
