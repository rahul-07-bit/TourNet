# ─────────────────────────────────────────────────────────────────────────────
# TourNet Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Only include VITE_ prefixed variables here — these are safe to expose
# in browser code. NEVER put secrets or backend-only credentials here.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Configuration (Frontend — Anon Key Only)
# Get from: https://supabase.com → Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key...

# Backend API URL
# Use 'http://localhost:3000' for local development
# Use your production backend URL for production builds
VITE_API_BASE_URL=http://localhost:3000
